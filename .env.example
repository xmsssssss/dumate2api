# Docker image
DUMATE_IMAGE=dumate2api:local

# Keep the single public service on loopback unless a reverse proxy or firewall is in front.
DUMATE_BIND_ADDR=127.0.0.1
DUMATE_GATEWAY_PORT=9080

# Sensitive runtime state: accounts, cookies, API keys, logs and admin state.
DUMATE_DATA_DIR=./data

# Optional fixed gateway key. Leave empty to create keys in the admin console.
DUMATE2API_KEY=

# Existing application options. Channel auto-start can be set to off.
DUMATE_DUMATE_SOURCE=web
DUMATE_QWENWORK_AUTOSTART=auto
DUMATE_TRAEWORK_AUTOSTART=auto
DUMATE_QODER_AUTOSTART=auto
DUMATE_CORS_ORIGINS=
# Container-local 127.0.0.1 points at the container itself. When using a
# host proxy, use a container-reachable address such as 172.17.0.1 or
# host.docker.internal instead.
DUMATE_PROXY=
